#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&{/trackball} {
    debounce-interval-ms = <10>;
};

/ {
    wio_rgb_test_leds {
        compatible = "pwm-leds";

        /* Colors are deliberately unknown until the hardware test. */
        wio_pwm_02: pin_02 {
            pwms = <&pwm1 0 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
        };
        wio_pwm_09: pin_09 {
            pwms = <&pwm1 1 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
        };
        wio_pwm_29: pin_29 {
            pwms = <&pwm1 2 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
        };
    };
};

&pinctrl {
    wio_rgb_pwm1_default: wio_rgb_pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>,
                    <NRF_PSEL(PWM_OUT1, 0, 9)>,
                    <NRF_PSEL(PWM_OUT2, 0, 29)>;
        };
    };

    wio_rgb_pwm1_sleep: wio_rgb_pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>,
                    <NRF_PSEL(PWM_OUT1, 0, 9)>,
                    <NRF_PSEL(PWM_OUT2, 0, 29)>;
            low-power-enable;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&wio_rgb_pwm1_default>;
    pinctrl-1 = <&wio_rgb_pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

/* P0.09 is an NFC pin on nRF52840. This changes UICR when flashed. */
&uicr {
    nfct-pins-as-gpios;
};
