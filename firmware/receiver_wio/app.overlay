
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    myo_pwm_leds {
        compatible = "pwm-leds";

        // Red LED connected to P0.29.
        red_pwm: red_pwm {
            pwms = <&pwm1 0 PWM_USEC(1000)
                    PWM_POLARITY_INVERTED>;
        };
    };
};

// PWM1 channel 0 -> GPIO P0.29.
&pinctrl {
    myo_pwm1_default: myo_pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 29)>;
        };
    };

    myo_pwm1_sleep: myo_pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 29)>;
            low-power-enable;
        };
    };
};

&pwm1 {
    status = "okay";

    pinctrl-0 = <&myo_pwm1_default>;
    pinctrl-1 = <&myo_pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};
